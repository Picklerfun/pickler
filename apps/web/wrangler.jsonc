{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-web-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "API", "service": "pickler-api-staging" },
    { "binding": "WORKER_SELF_REFERENCE", "service": "pickler-web-staging" },
  ],
  "observability": { "enabled": true },
  "vars": { "NEXTJS_ENV": "production" },
  "previews": {
    "vars": { "NEXTJS_ENV": "production" },
    // Branch previews are presentation-only; do not inherit live backend access.
    "services": [],
  },
}
