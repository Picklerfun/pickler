# Public Supabase Auth values only; inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true only once X (Supabase calls it `twitter`) has credentials on the Supabase
# project; the account screen leaves the button out otherwise.
NEXT_PUBLIC_OAUTH_X_ENABLED=false
# The marketplace's Mera passkey wallet. The relying party defaults to pickler.fun, the same as the
# mobile app's, and is only ever changed for a staging host; it is never the studio's host.
# NEXT_PUBLIC_MERA_WEB=off takes the passkey wallet out of the chooser.
NEXT_PUBLIC_MERA_RP_ID=
NEXT_PUBLIC_MERA_WEB=
# Optional loopback API URL for next dev. Workers use the API Service Binding.
PICKLER_API_LOCAL_URL=
