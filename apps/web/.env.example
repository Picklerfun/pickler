# Public Supabase Auth values only; inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true only once X (Supabase calls it `twitter`) has credentials on the Supabase
# project; the account screen leaves the button out otherwise.
NEXT_PUBLIC_OAUTH_X_ENABLED=false
# The two product hosts, inlined at build time. Unset, they are pickler.fun (marketplace) and
# app.pickler.fun (studio). Any other host — localhost, a preview — serves both products.
# To rehearse the split locally, use two *.localhost hosts with the dev port; browsers resolve
# *.localhost to this machine, and they are reached over http:
#   NEXT_PUBLIC_MARKETPLACE_HOST=pickler.localhost:3001
#   NEXT_PUBLIC_STUDIO_HOST=app.pickler.localhost:3001
NEXT_PUBLIC_MARKETPLACE_HOST=
NEXT_PUBLIC_STUDIO_HOST=
# Optional loopback API URL for next dev. Workers use the API Service Binding.
PICKLER_API_LOCAL_URL=
