# "supabase" reads live data; anything else serves labelled sample data.
PICKLER_DATA_SOURCE=sample
# Required when PICKLER_DATA_SOURCE=supabase. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Auth screens (/signup, /signin). Public values: they are inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pickler API worker (workers/api), e.g. http://localhost:8788 locally.
NEXT_PUBLIC_PICKLER_API_URL=
# Chain id in Sign-In with Ethereum messages (10143 = Monad testnet).
NEXT_PUBLIC_SIWE_CHAIN_ID=10143
