    "@pickler/api-schema": "*",
    "@pickler/core": "*",
    "@pickler/infrastructure": "*",
    "@pickler/trading": "*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pickler/typescript-config": "*",
    "mastra": "1.30.0",
    "wrangler": "4.133.0"
