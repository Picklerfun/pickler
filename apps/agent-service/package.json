    "prepare:decision-evidence": "node --import tsx src/prepare-decision-evidence.ts",
    "configure:categories": "node --import tsx src/configure-categories.ts",
    "validate:agent": "node --import tsx src/validate-agent.ts",
    "wallet:init": "node --import tsx src/wallet-init.ts",
    "trading:setup": "node --import tsx src/trading-setup.ts",
    "polymarket:preproduction": "node --import tsx src/polymarket-preproduction.ts",
    "compare:decisions": "node --import tsx src/compare-decisions.ts",
