POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Explicit operator opt-in. Requires an already deployed/funded account.
POLYMARKET_TRADING_RUNTIME=off

# Explicit operator wallet binding; no automatic laboratory assignment.
TRADING_TENANT_ID=
TRADING_AGENT_ID=

# Optional, isolated decision-evaluation laboratory.
TYPESAFE_API_KEY=

# Optional capture only. No additional provider calls; see DECISION-OBSERVATION.md.
JEV_OBSERVATION_MODE=off
JEV_OBSERVATION_DIRECTORY=.data/decision-observations
JEV_OBSERVATION_TENANT_ID=
JEV_OBSERVATION_AGENT_ID=
