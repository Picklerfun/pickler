{
  "$schema": "../../../../../node_modules/wrangler/config-schema.json",
  "name": "pickler-background-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "RESEARCH_QUEUE", "queue": "pickler-research-local" }],
    "consumers": [
      {
        "queue": "pickler-research-local",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 5,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
}
