{
  "name": "pickler-monorepo",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pickler/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "npm run check:architecture && npm run build:shared && node --import tsx --test packages/core/test/*.test.ts packages/trading/test/*.test.ts packages/infrastructure/test/*.test.ts packages/chain/test/*.test.ts packages/mera-account/test/*.test.ts packages/perpl-context/test/*.test.ts packages/agent-runtime/test/*.test.ts workers/api/test/*.test.ts apps/agent-service/test/*.test.ts workers/research/test/*.test.ts workers/trading/test/*.test.ts workers/indexer/test/*.test.ts apps/web/test/*.test.ts scripts/design/*.test.mjs",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts --no-match-path 'test/fork/*'",
    "dev:agent": "npm run build:shared && npm run dev --workspace=@pickler/agent-service",
    "build:shared": "turbo run build --filter=@pickler/core --filter=@pickler/infrastructure --filter=@pickler/api-schema --filter=@pickler/agent-runtime --filter=@pickler/trading",
    "agent": "npm run cli --workspace=@pickler/agent-service --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "db:generate": "npm run db:generate --workspace=@pickler/infrastructure",
    "db:migrate": "npm run db:migrate --workspace=@pickler/infrastructure",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:supabase": "TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54522/postgres npm test",
    "check:staging": "node scripts/check-staging.mjs",
    "build:workers": "npm run build:shared && npm run build:worker --workspace=@pickler/api && npm run build:worker --workspace=@pickler/research-worker && npm run build:worker --workspace=@pickler/trading-worker && npm run build:worker --workspace=@pickler/indexer-worker && npm run build:worker --workspace=@pickler/web",
    "test:workers-local": "node --import tsx --test workers/research/test/worker-flow.test.ts",
    "evaluate": "npm run evaluate --workspace=@pickler/agent-service --",
    "check:architecture": "node scripts/check-trading-architecture.mjs",
    "contracts:test:fork": "forge test --root contracts --match-path 'test/fork/*'",
    "contracts:abi": "npm run contracts:build && node scripts/generate-abi.mjs",
    "typecheck:design": "tsc -p scripts/design/tsconfig.json",
    "design:source": "node scripts/design/source.mjs --strict",
    "design:check": "node scripts/design/run.mjs --strict",
    "design:shots": "node scripts/design/run.mjs shots",
    "design:compare": "node scripts/design/compare.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
