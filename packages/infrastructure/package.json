{
  "name": "@pickler/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": "./test/database.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../apps/agent-service/.env --import tsx src/persistence/migrate.ts"
  },
  "devDependencies": {
    "@pickler/typescript-config": "*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@pickler/core": "*",
    "@supabase/supabase-js": "^2.116.0",
    "@turnkey/api-key-stamper": "^0.6.15",
    "@turnkey/http": "^6.5.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "pg": "8.20.0",
    "zod": "4.6.5"
  },
  "files": [
    "dist",
    "src",
    "drizzle"
  ]
}
