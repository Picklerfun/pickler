{
  "name": "pickler-mobile-tooling",
  "private": true,
  "description": "Docs and agent tooling of the mobile app's imported record (docs/mobile). Not a workspace: install with npm ci --prefix scripts/mobile.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agents:check": "node agent-infra/check.mjs",
    "agents:test": "bash test-lock.sh node --test --test-concurrency=1 agent-infra/*.test.mjs",
    "agents:inventory": "node agent-infra/branches.mjs",
    "docs:html": "node docs-md-to-html.mjs --all",
    "docs:check": "node docs-md-to-html.mjs --all --check",
    "app:tree": "node app-tree.mjs --check",
    "app:tree:write": "node app-tree.mjs --write"
  },
  "devDependencies": {
    "puppeteer-core": "^24.24.1",
    "yaml": "2.9.0"
  }
}
