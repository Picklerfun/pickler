diff --git a/scripts/design/lib/servers.mjs b/scripts/design/lib/servers.mjs
new file mode 100644
index 0000000..a1d7f4e
--- /dev/null
+++ b/scripts/design/lib/servers.mjs
@@ -0,0 +1,141 @@
+/* The two servers the rendered checks need, and how the runner starts and stops them.
+ *
+ * The web app renders on the server and asks an API for its data, so a check needs both: the
+ * fixture API (fixture-api.mjs) and Next pointed at it. The ports are fixed because the checks'
+ * remedies name them; a port that is already taken is never reused on a guess, because another
+ * checkout of this repository serves the same application on a neighbouring port and measuring it
+ * would report somebody else's branch. */
+import { spawn } from "node:child_process";
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { connect } from "node:net";
+import path from "node:path";
+
+export const FIXTURE_PORT = 8799;
+export const WEB_PORT = 3001;
+export const BASE_URL = `http://localhost:${WEB_PORT}`;
+
+/* `next dev` rewrites this tracked file to point at its own types folder, and leaves it that way.
+ * In a worktree several agents commit from, that is a change nobody made waiting to be swept into
+ * somebody's commit, so the runner puts back what it found. */
+const REWRITTEN = ["apps/web/next-env.d.ts"];
+
+/** Whether anything accepts a connection on this port, on either loopback address. */
+export async function listening(port) {
+  const tried = await Promise.all(
+    ["127.0.0.1", "::1"].map(
+      (host) =>
+        new Promise((resolve) => {
+          const socket = connect({ port, host });
+          const answer = (value) => {
+            socket.destroy();
+            resolve(value);
+          };
+          socket.once("connect", () => answer(true));
+          socket.once("error", () => answer(false));
+          socket.setTimeout(1000, () => answer(false));
+        }),
+    ),
+  );
+  return tried.some(Boolean);
+}
+
+/**
+ * The environment Next runs in for a check.
+ *
+ * The API is the fixture. Supabase is switched off by setting both of its variables to nothing: a
+ * variable that is set, even to the empty string, is not overwritten by apps/web/.env.local, and
+ * with authentication unconfigured the studio and the account render from their preview fixtures
+ * instead of redirecting a browser that has no session to /signin.
+ */
+export function webEnv(env) {
+  return {
+    ...env,
+    PICKLER_API_LOCAL_URL: `http://127.0.0.1:${FIXTURE_PORT}`,
+    NEXT_PUBLIC_SUPABASE_URL: "",
+    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: "",
+  };
+}
+
+/** What the runner does about the servers, decided from what is already there. */
+export function plan({ baseUrl, fixtureBusy, webBusy }) {
+  if (baseUrl) {
+    return { start: false, baseUrl, refuse: null };
+  }
+  const busy = [...(fixtureBusy ? [FIXTURE_PORT] : []), ...(webBusy ? [WEB_PORT] : [])];
+  if (busy.length) {
+    return {
+      start: false,
+      baseUrl: null,
+      refuse:
+        `port ${busy.join(" and ")} already in use, and this runner did not start what is there.\n` +
+        `Stop it, or name the server to measure: DESIGN_BASE_URL=${BASE_URL} npm run design:check`,
+    };
+  }
+  return { start: true, baseUrl: BASE_URL, refuse: null };
+}
+
+async function answers(url, timeoutMs) {
+  const until = Date.now() + timeoutMs;
+  while (Date.now() < until) {
+    try {
+      const response = await fetch(url);
+      if (response.status < 500) {
+        return true;
+      }
+    } catch {
+      // Not up yet.
+    }
+    await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+  return false;
+}
+
+/** Starts both servers and answers how to stop them. Throws if either never comes up. */
+export async function start(root, log = () => {}) {
+  const children = [];
+  const launch = (command, args, options) => {
+    // Its own process group, so stopping it stops whatever it started too.
+    const child = spawn(command, args, { ...options, detached: true, stdio: "pipe" });
+    child.stdout.on("data", (chunk) => log(String(chunk)));
+    child.stderr.on("data", (chunk) => log(String(chunk)));
+    children.push(child);
+    return child;
+  };
+  const found = REWRITTEN.map((file) => path.join(root, file))
+    .filter((file) => existsSync(file))
+    .map((file) => [file, readFileSync(file, "utf8")]);
+  const stop = () => {
+    for (const child of children) {
+      try {
+        process.kill(-child.pid, "SIGTERM");
+      } catch {
+        // Already gone.
+      }
+    }
+    for (const [file, text] of found) {
+      if (readFileSync(file, "utf8") !== text) {
+        writeFileSync(file, text);
+      }
+    }
+  };
+  try {
+    launch(
+      process.execPath,
+      ["--import", "tsx", "scripts/design/fixture-api.mjs", String(FIXTURE_PORT)],
+      { cwd: root, env: process.env },
+    );
+    launch(path.join(root, "node_modules/.bin/next"), ["dev", "-p", String(WEB_PORT)], {
+      cwd: path.join(root, "apps/web"),
+      env: webEnv(process.env),
+    });
+    const fixtureUp = await answers(`http://127.0.0.1:${FIXTURE_PORT}/v1/landing`, 60_000);
+    const webUp = fixtureUp && (await answers(`${BASE_URL}/`, 180_000));
+    if (!fixtureUp || !webUp) {
+      throw new Error(`${fixtureUp ? "the web app" : "the fixture API"} did not come up`);
+    }
+  } catch (error) {
+    stop();
+    throw error;
+  }
+  return { stop };
+}
diff --git a/scripts/design/run.mjs b/scripts/design/run.mjs
new file mode 100644
index 0000000..6b3631c
--- /dev/null
+++ b/scripts/design/run.mjs
@@ -0,0 +1,77 @@
+// One command for the design checks: the static one, then the rendered ones against servers this
+// starts and stops itself.
+//
+//   npm run design:check                       every check
+//   node scripts/design/run.mjs tokens type    only those
+//   node scripts/design/run.mjs shots          screenshots (DESIGN_SHOTS_DIR names the folder)
+//   DESIGN_BASE_URL=http://localhost:3001 …    measure a server that is already up; start nothing
+//
+// --strict is handed to the static check, which otherwise only reports.
+// Exit 0 clean, 1 a check found something, 2 refused to measure.
+import { spawnSync } from "node:child_process";
+import { appendFileSync, mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { FIXTURE_PORT, WEB_PORT, listening, plan, start } from "./lib/servers.mjs";
+
+const ROOT = fileURLToPath(new URL("../..", import.meta.url));
+const RENDERED = ["surfaces", "tokens", "contrast", "type", "shots"];
+const DEFAULT = ["source", "surfaces", "tokens", "contrast", "type"];
+
+const flags = process.argv.slice(2).filter((arg) => arg.startsWith("--"));
+const named = process.argv.slice(2).filter((arg) => !arg.startsWith("--"));
+const checks = named.length ? named : DEFAULT;
+const unknown = checks.filter((check) => check !== "source" && !RENDERED.includes(check));
+if (unknown.length) {
+  process.stderr.write(`no such check: ${unknown.join(", ")}\n`);
+  process.exit(2);
+}
+
+const run = (script, args, env) =>
+  spawnSync(process.execPath, [path.join("scripts/design", script), ...args], {
+    cwd: ROOT,
+    env,
+    stdio: "inherit",
+  }).status ?? 2;
+
+let worst = 0;
+if (checks.includes("source")) {
+  worst = Math.max(worst, run("source.mjs", flags.includes("--strict") ? ["--strict"] : []));
+}
+
+const rendered = checks.filter((check) => RENDERED.includes(check));
+if (rendered.length) {
+  const decided = plan({
+    baseUrl: process.env.DESIGN_BASE_URL,
+    fixtureBusy: await listening(FIXTURE_PORT),
+    webBusy: await listening(WEB_PORT),
+  });
+  if (decided.refuse) {
+    process.stderr.write(`${decided.refuse}\n`);
+    process.exit(2);
+  }
+  let servers = null;
+  if (decided.start) {
+    // The servers' own output goes to a file: it is the first place to look when a route answers
+    // 500, and on screen it would bury the report.
+    const log = path.join(ROOT, "scripts/design/.shots/servers.log");
+    mkdirSync(path.dirname(log), { recursive: true });
+    writeFileSync(log, "");
+    process.stdout.write(`starting the fixture API and the web app (log: ${log})\n`);
+    try {
+      servers = await start(ROOT, (text) => appendFileSync(log, text));
+    } catch (error) {
+      process.stderr.write(`${error.message}; read ${log}\n`);
+      process.exit(2);
+    }
+  }
+  try {
+    for (const check of rendered) {
+      const env = { ...process.env, DESIGN_BASE_URL: decided.baseUrl };
+      worst = Math.max(worst, run(`${check}.mjs`, [], env));
+    }
+  } finally {
+    servers?.stop();
+  }
+}
+process.exit(worst);
