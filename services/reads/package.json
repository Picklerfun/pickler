{
  "name": "pickler-reads",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "migrate:dry": "node scripts/migrate.mjs --dry",
    "query": "node scripts/query.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "test:deno": "deno test -A supabase/functions/_shared/",
    "test": "npm run test:scripts && npm run test:deno",
    "sign": "node scripts/sign.mjs",
    "smoke": "bash scripts/smoke.sh",
    "deploy": "npx supabase functions deploy --project-ref yvdipvcrpbqvofayteqf --no-verify-jwt"
  },
  "devDependencies": {
    "viem": "2.56.8",
    "supabase": "2.117.0",
    "@anthropic-ai/sdk": "0.127.0",
    "zod": "4.6.5",
    "postgres": "3.4.9"
  }
}
