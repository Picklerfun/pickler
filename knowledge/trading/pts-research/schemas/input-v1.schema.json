{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline PTS research input manifest v1",
  "description": "Syntactic contract only. Host verifies files, hashes, exact policies, native evidence and window order without loading an environment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "reference",
    "candidates",
    "sources",
    "dataUse",
    "historyWindow"
  ],
  "properties": {
    "format": {
      "const": "pts-research-input-v1"
    },
    "version": {
      "const": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "file", "sha256"],
      "properties": {
        "id": {
          "const": "pts-intraday"
        },
        "version": {
          "const": "0.2.0-fast.2"
        },
        "file": {
          "$ref": "#/$defs/localJsonFile"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "file", "sha256"],
          "properties": {
            "id": {
              "const": "primary-er20"
            },
            "version": {
              "const": "0.1.0"
            },
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "file", "sha256"],
          "properties": {
            "id": {
              "const": "persistent-setups"
            },
            "version": {
              "const": "0.1.0"
            },
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "file", "sha256"],
          "properties": {
            "id": {
              "const": "ready-band-entry"
            },
            "version": {
              "const": "0.1.0"
            },
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "file", "sha256"],
          "properties": {
            "id": {
              "const": "retracement-control"
            },
            "version": {
              "const": "0.1.0"
            },
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit", "history"],
      "properties": {
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "payloadHash"],
          "properties": {
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "historyHash"],
          "properties": {
            "file": {
              "$ref": "#/$defs/localJsonFile"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "historyHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "dataUse": {
      "const": "examined-development"
    },
    "historyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "stepSeconds"],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 300000
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 300000
        },
        "stepSeconds": {
          "const": 300
        }
      },
      "description": "Host additionally requires from < to, at most seven days, and containment in the pinned original history interval."
    }
  },
  "$defs": {
    "localJsonFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\.json$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          },
          {
            "pattern": "\u0000"
          }
        ]
      }
    }
  }
}
