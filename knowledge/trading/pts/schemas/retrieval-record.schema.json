{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PTS retrieval record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bundleId",
    "knowledgeVersion",
    "kind",
    "language",
    "title",
    "text",
    "textSha256",
    "trust",
    "currentMarketEvidence",
    "sourceReferences",
    "ruleIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "bundleId": {
      "const": "pts-course"
    },
    "knowledgeVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": ["transcript", "concept"]
    },
    "language": {
      "enum": ["es", "en"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "textSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trust": {
      "const": "reference-data"
    },
    "currentMarketEvidence": {
      "const": false
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "lineStart", "lineEnd"],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^M[1-4]C[1-9][0-9]*$"
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "ruleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
