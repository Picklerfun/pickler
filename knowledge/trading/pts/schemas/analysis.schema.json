{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PTS proposed analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "bundleId",
    "knowledgeVersion",
    "example",
    "candidateId",
    "mode",
    "instrument",
    "analysisTime",
    "status",
    "direction",
    "executionAuthorized",
    "summary",
    "findings",
    "unresolvedQuestionIds"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/analysis.schema.json"
    },
    "bundleId": {
      "const": "pts-course"
    },
    "knowledgeVersion": {
      "const": "1.0.0"
    },
    "example": {
      "type": "boolean"
    },
    "candidateId": {
      "const": "pts-trend-reversal"
    },
    "mode": {
      "const": "analysis-only"
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "analysisTime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["insufficient-data", "unresolved-policy", "conditions-met", "conditions-not-met"]
    },
    "direction": {
      "enum": ["long", "short", "undetermined"]
    },
    "executionAuthorized": {
      "const": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "title": "PTS condition finding",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conditionId",
          "state",
          "reason",
          "marketEvidenceRefs",
          "resolvedDefinitionIds",
          "courseReferences"
        ],
        "properties": {
          "conditionId": {
            "enum": [
              "market-data-complete",
              "primary-trend-defined",
              "weekly-channel-aligned",
              "correction-at-channel-boundary",
              "retracement-in-reversal-zone",
              "entry-trigger-confirmed",
              "structural-invalidation-defined"
            ]
          },
          "state": {
            "enum": ["met", "not-met", "unknown"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "marketEvidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "resolvedDefinitionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "courseReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "lineStart", "lineEnd"],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^M[1-4]C[1-9][0-9]*$"
                },
                "lineStart": {
                  "type": "integer",
                  "minimum": 1
                },
                "lineEnd": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": ["met", "not-met"]
                }
              }
            },
            "then": {
              "properties": {
                "marketEvidenceRefs": {
                  "minItems": 1
                },
                "resolvedDefinitionIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "unresolvedQuestionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "market-data-complete"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "primary-trend-defined"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "weekly-channel-aligned"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "correction-at-channel-boundary"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "retracement-in-reversal-zone"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "entry-trigger-confirmed"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "properties": {
        "findings": {
          "contains": {
            "properties": {
              "conditionId": {
                "const": "structural-invalidation-defined"
              }
            },
            "required": ["conditionId"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "conditions-met"
          }
        }
      },
      "then": {
        "properties": {
          "direction": {
            "enum": ["long", "short"]
          },
          "findings": {
            "items": {
              "properties": {
                "state": {
                  "const": "met"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "conditions-not-met"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "state": {
                  "const": "not-met"
                }
              }
            }
          }
        }
      }
    }
  ]
}
