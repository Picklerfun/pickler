          "lineEnd": 56
        }
      ],
      "unresolvedQuestionIds": ["Q-timeframes"]
    },
    {
      "id": "trend-direction",
      "title": "Trade with the primary trend",
      "finding": "Prefer longs near the lower boundary of an upward channel and shorts near the upper boundary of a downward channel. The larger channel takes priority over internal channels.",
