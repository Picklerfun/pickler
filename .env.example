# Single operator-maintained file: copy this template to .env at the repository root.
# Never commit .env. Local is the default; select staging explicitly with PICKLER_ENVIRONMENT=staging.

# Shared provider credentials (only agent/research processes receive these).
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
EXA_API_KEY=
BALLDONTLIE_API_KEY=
THE_ODDS_API_KEY=

# Local Studio, including its existing database and tenant tokens.
AGENT_DATABASE_URL=
AGENT_DATABASE_MIGRATION_URL=
TENANT_ALPHA_TOKEN=
TENANT_BETA_TOKEN=

# Local API and research Worker database / authentication.
LOCAL_DATABASE_URL=
LOCAL_DATABASE_MIGRATION_URL=
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_SECRET_KEY=
LOCAL_JWT_ISSUER=
LOCAL_JWT_AUDIENCE=authenticated
LOCAL_ALLOWED_ORIGINS=http://localhost:3000
LOCAL_ENCRYPTION_KEY=
LOCAL_ADMISSIONS_ENABLED=false

# Only this public configuration is passed to Next.js.
LOCAL_NEXT_PUBLIC_SUPABASE_URL=
LOCAL_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LOCAL_NEXT_PUBLIC_SIWE_CHAIN_ID=10143
LOCAL_PICKLER_API_LOCAL_URL=http://127.0.0.1:8787

# Staging database: password components are assembled in memory, never logged.
STAGING_SUPABASE_PROJECT_REF=
STAGING_DATABASE_HOST=
STAGING_DATABASE_PORT=5432
STAGING_DATABASE_NAME=postgres
STAGING_DATABASE_USER=
STAGING_DATABASE_PASSWORD=
# Optional complete URL takes precedence over the password components.
STAGING_DATABASE_URL=
STAGING_DATABASE_CA_CERT=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SECRET_KEY=
STAGING_JWT_ISSUER=
STAGING_JWT_AUDIENCE=authenticated
STAGING_ALLOWED_ORIGINS=
STAGING_ENCRYPTION_KEY=
STAGING_ADMISSIONS_ENABLED=false
STAGING_NEXT_PUBLIC_SUPABASE_URL=
STAGING_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
STAGING_NEXT_PUBLIC_SIWE_CHAIN_ID=10143

# Generated dedicated test identity; fixture target only, never deployed.
LOCAL_CONTROLLED_TEST_DATABASE_ID=
