{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-trading-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [{ "binding": "DATABASE", "id": "05150d06f7164d26a991288a88044710" }],
  "queues": {
    "producers": [{ "binding": "TRADING_QUEUE", "queue": "pickler-trading-queue-staging" }],
    "consumers": [
      {
        "queue": "pickler-trading-queue-staging",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "staging", "TRADING_ADMISSIONS_ENABLED": "false" },
}
