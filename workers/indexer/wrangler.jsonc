{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-indexer-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "hyperdrive": [{ "binding": "DATABASE", "id": "05150d06f7164d26a991288a88044710" }],
  // Public reviewed policies are provisioned as runtime bindings before operator activation.
  "vars": {
    "APP_ENV": "staging",
    "TOKEN_INDEXER_ENABLED": "true",
    "CHAIN_ID": "10143",
    "RPC_URLS": "https://rpc.ankr.com/monad_testnet",
    "CONFIRMATIONS": "5",
    "MAX_BLOCKS_PER_PASS": "100",
  },
}
