{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "producers": [
      { "binding": "RESEARCH_QUEUE", "queue": "pickler-research-staging" },
      { "binding": "TRADING_QUEUE", "queue": "pickler-trading-queue-staging" },
    ],
  },
  "services": [{ "binding": "TRADING_EXECUTOR", "service": "pickler-trading-staging" }],
  "hyperdrive": [{ "binding": "DATABASE", "id": "05150d06f7164d26a991288a88044710" }],
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "staging",
    "TRADING_ADMISSIONS_ENABLED": "false",
    "ADMISSIONS_ENABLED": "true",
    "JWT_AUDIENCE": "authenticated",
  },
}
