{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pickler-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": { "producers": [{ "binding": "RESEARCH_QUEUE", "queue": "pickler-research-staging" }] },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "staging", "ADMISSIONS_ENABLED": "false", "JWT_AUDIENCE": "authenticated" },
}
