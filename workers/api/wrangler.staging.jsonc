{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "producers": [
      { "binding": "RESEARCH_QUEUE", "queue": "pickler-research-staging" },
      { "binding": "TRADING_QUEUE", "queue": "pickler-trading-queue-staging" },
    ],
  },
  "services": [{ "binding": "TRADING_EXECUTOR", "service": "pickler-trading-staging" }],
  "hyperdrive": [{ "binding": "DATABASE", "id": "05150d06f7164d26a991288a88044710" }],
  "r2_buckets": [{ "binding": "TOKEN_METADATA", "bucket_name": "pickler-token-metadata-testnet" }],
  "observability": { "enabled": true },
  "vars": {
    "ADVICE_ENABLED": "false",
    "ADVICE_X402_ENABLED": "false",
    "APP_ENV": "staging",
    "CHAIN_ID": "10143",
    "MONAD_RPC_URL": "https://rpc.ankr.com/monad_testnet",
    "TOKEN_LAUNCH_ENABLED": "true",
    "TRADING_ADMISSIONS_ENABLED": "false",
    "ADMISSIONS_ENABLED": "true",
    "JWT_AUDIENCE": "authenticated",
    "PERPL_BOARD_NETWORK": "testnet",
    // Must match workers/research/wrangler.jsonc.
    "PERPL_RUNTIME_ENABLED": "false",
  },
}
