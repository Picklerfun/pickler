APP_ENV=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=authenticated
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=
ADMISSIONS_ENABLED=true

# Optional PEM CA for Node connections; Workers uses platform TLS verification.
DATABASE_CA_CERT=

# Temporary hosted plaintext exception: only valid with APP_ENV=staging.
# Leave false for local development and normal TLS deployment.
ALLOW_INSECURE_STAGING_DATABASE=false
