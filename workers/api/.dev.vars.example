APP_ENV=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=authenticated
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=
ADMISSIONS_ENABLED=true

# Turnkey. The API keys are the parent organisation's and are secrets; the rest is configuration.
# Without all five, /v1/signing is not mounted and the rest of the API serves as before.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_PARENT_ORG_ID=
# The WebAuthn relying party. `localhost` here; `app.pickler.fun` in every deployed
# environment, and it is a one-way door: changing it orphans every passkey already enrolled.
# Never `pickler.fun`: that is Mera's relying party, and the API turns custody off on it, as it
# does on `localhost` outside local development. See docs/specs/mobile-monorepo-v1.md W1-W2, W8.
TURNKEY_RPID=localhost
TURNKEY_APP_NAME=Pickler
# Pickler's delegated API key pair: the only credential of the non-root user a person creates in
# their own sub-organization when they make their first agent. Generate a pair with
# `npm run turnkey:delegated-key`. The public key is optional here — without it the agent wallet
# ceremony answers 503 — and the private key is held by Pickler, unused until live trading, and
# never logged. Both are secrets in deployed environments.
TURNKEY_DELEGATED_API_PUBLIC_KEY=
TURNKEY_DELEGATED_API_PRIVATE_KEY=
# Balance reads: the signing routes' wallet balances and each studio agent's AUSD balance, which
# decides its schedule and "+ New agent" locks. Absent CHAIN_ID means Monad testnet (10143).
# Absent MONAD_RPC_URL means that network's first public endpoint (rate-limited).
CHAIN_ID=10143
MONAD_RPC_URL=
# The Perpl network the public market board reads: testnet or mainnet. Absent serves the sample
# board, labelled SAMPLE DATA on the page. With it set, /v1/marketplace/markets calls Perpl's
# public API from this machine.
PERPL_BOARD_NETWORK=testnet
# The Perpl paper runtime (docs/specs/perpl-paper-runtime-v1.md R3): "true" admits manual checks
# and proposal approvals, which the research worker runs; keep it equal to the research worker's.
# Anything else answers 409 RUNTIME_DISABLED; reads, closes and stops stay on.
PERPL_RUNTIME_ENABLED=false

# Wallet sign-in. Both are required together: `walletAuthServices` returns undefined when either
# is missing, so /v1/auth/wallet is simply not mounted rather than mounted and broken.
# SIWE_DOMAIN is the domain a signature is accepted for — a signature made for another site is
# refused against it, so it must match the host people actually sign on.
# `app.pickler.fun` in every deployed environment (the marketplace host; the phone signs the same
# domain). See docs/specs/product-hosts-v1.md §4.
SIWE_DOMAIN=
# The domain of the synthetic, non-deliverable address a wallet account is created under. It is an
# internal key and never a contact, so this domain must never be made to accept mail.
WALLET_EMAIL_DOMAIN=

# Read-only Connect X OAuth. API runtime only, disabled by default.
# Hosted callback must be registered exactly as shown; register a separate local callback for tests.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://app.pickler.fun/api/v1/studio/x/callback
X_TOKEN_ENCRYPTION_KEY=
X_TOKEN_ENCRYPTION_KEY_VERSION=1
X_OAUTH_ENABLED=false
X_READS_ENABLED=false
# Reviewed version, reviewedAt, identityRequestsPerDay, postRequestsPerDay, postResourcesPerDay.
# No commercial quotas or tariffs are supplied; see docs/studio-x-oauth.md.
X_API_POLICY_JSON=

# Comma-separated. Empty means nobody; this is not a fallback that opens up when unset.
SUPER_ADMIN_EMAILS=

# DATABASE_URL is local-only. Hosted API uses the DATABASE Hyperdrive binding.
# Locally, SUPABASE_URL and SUPABASE_SECRET_KEY serve auth only (JWKS and the auth admin API);
# every product row goes to DATABASE_URL, never to the hosted project's tables.
