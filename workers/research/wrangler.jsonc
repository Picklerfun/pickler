{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "name": "pickler-research-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [{ "binding": "DATABASE", "id": "05150d06f7164d26a991288a88044710" }],
  "queues": {
    "producers": [
      { "binding": "RESEARCH_QUEUE", "queue": "pickler-research-staging" },
      { "binding": "TRADING_QUEUE", "queue": "pickler-trading-queue-staging" },
    ],
    "consumers": [
      {
        "queue": "pickler-research-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "staging",
    "ADMISSIONS_ENABLED": "true",
  },
}
